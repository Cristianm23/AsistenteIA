<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsistenteIA.Views.DetailPage"
             Title="Detalle">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Consulta" FontAttributes="Bold" FontSize="18"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Prompt}" LineBreakMode="WordWrap" />

            <Label Text="Respuesta de la IA" FontAttributes="Bold" FontSize="18"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Answer}" LineBreakMode="WordWrap" />

            <Label Text="{Binding DateText, StringFormat='Fecha: {0}'}" FontSize="13" />
            <Label Text="{Binding Category, StringFormat='Categoría: {0}'}" FontSize="13" />

            <Label Text="Marque la respuesta como verificada solo después de contrastarla con fuentes confiables."
                   FontSize="12" TextColor="OrangeRed" LineBreakMode="WordWrap" />

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding IsVerified}"
                        SemanticProperties.Description="Marcar respuesta como verificada" />
                <Label Text="Respuesta verificada" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Eliminar consulta"
                    Command="{Binding DeleteCommand}"
                    SemanticProperties.Description="Eliminar esta consulta del historial" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>