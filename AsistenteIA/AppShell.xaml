<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AsistenteIA.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AsistenteIA.Views"
    Title="AsistenteIA">

    <TabBar>
        <ShellContent Title="Inicio"
                      ContentTemplate="{DataTemplate views:HomePage}"
                      Route="HomePage" />
        <ShellContent Title="Consultar"
                      ContentTemplate="{DataTemplate views:ChatPage}"
                      Route="ChatPage" />
        <ShellContent Title="Historial"
                      ContentTemplate="{DataTemplate views:HistoryPage}"
                      Route="HistoryPage" />
        <ShellContent Title="Configuración"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="SettingsPage" />
    </TabBar>
</Shell>